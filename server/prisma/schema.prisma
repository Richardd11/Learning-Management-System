generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ── Enums ────────────────────────────────────────────────────────

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum AcademicLevelType {
  HIGH_SCHOOL
  COLLEGE
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

enum LessonContentType {
  VIDEO
  PDF
  TEXT
  YOUTUBE
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

enum NotificationType {
  ENROLLMENT
  GRADE
  ANNOUNCEMENT
  ACHIEVEMENT
  SYSTEM
}

enum Semester {
  FIRST
  SECOND
  SUMMER
}

// ── Academic Levels ──────────────────────────────────────────────

model AcademicLevel {
  id         String             @id @default(cuid())
  type       AcademicLevelType
  gradeLabel String             // "Grade 7", "1st Year", etc.
  orderIndex Int                @default(0) // for sorting: Grade 7=0, Grade 8=1, etc.
  isActive   Boolean            @default(true)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  sections   Section[]
  users      User[]
  courses    Course[]

  @@unique([type, gradeLabel])
  @@map("academic_levels")
}

model Section {
  id              String           @id @default(cuid())
  name            String           // "Section A", "BSCS Block 1", etc.
  academicLevelId String
  schoolYear      String           // "2024-2025"
  semester        Semester?        // Only for COLLEGE type
  capacity        Int              @default(40)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  academicLevel   AcademicLevel    @relation(fields: [academicLevelId], references: [id])
  users           User[]
  enrollments     Enrollment[]
  courses         Course[]       @relation("SectionCourses")

  @@unique([name, academicLevelId, schoolYear])
  @@map("sections")
}

// ── Users ────────────────────────────────────────────────────────

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String?
  firstName       String
  lastName        String
  avatar          String?
  bio             String?
  role            Role     @default(STUDENT)
  academicLevelId String?
  sectionId       String?
  studentIdNumber String?  // School-issued student ID
  dateOfBirth     DateTime?
  xp              Int      @default(0)
  streak          Int      @default(0)
  lastActiveAt    DateTime @default(now())
  isBanned        Boolean  @default(false)
  socialLinks     Json?
  googleId        String?  @unique
  githubId        String?  @unique
  refreshToken    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  academicLevel   AcademicLevel?   @relation(fields: [academicLevelId], references: [id])
  section         Section?         @relation(fields: [sectionId], references: [id])
  courses         Course[]         @relation("InstructorCourses")
  enrollments     Enrollment[]
  reviews         Review[]
  certificates    Certificate[]
  notifications   Notification[]
  notes           Note[]
  progress        LessonProgress[]
  quizAttempts    QuizAttempt[]
  announcements   Announcement[]   @relation("AnnouncementAuthor")

  @@map("users")
}

// ── Courses ──────────────────────────────────────────────────────

model Course {
  id               String       @id @default(cuid())
  title            String
  slug             String       @unique
  description      String
  shortDesc        String?
  thumbnail        String?
  subjectCode      String?      // "MATH101", "SCI-201", etc.
  price            Float        @default(0)
  difficulty       String       @default("beginner")
  status           CourseStatus @default(DRAFT)
  tags             String[]
  rating           Float        @default(0)
  ratingCount      Int          @default(0)
  enrollCount      Int          @default(0)
  instructorId     String
  academicLevelId  String?
  publishedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  instructor       User           @relation("InstructorCourses", fields: [instructorId], references: [id])
  academicLevel    AcademicLevel? @relation(fields: [academicLevelId], references: [id])
  sections         Section[]      @relation("SectionCourses")
  modules          Module[]
  enrollments      Enrollment[]
  reviews          Review[]
  certificates     Certificate[]
  embeddings       CourseEmbedding[]
  announcements    Announcement[] @relation("CourseAnnouncements")

  @@map("courses")
}

// ── Modules & Lessons ────────────────────────────────────────────

model Module {
  id          String   @id @default(cuid())
  title       String
  order       Int
  isPublished Boolean  @default(false)
  courseId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]
  quizzes Quiz[]

  @@map("modules")
}

model Lesson {
  id            String            @id @default(cuid())
  title         String
  content       String?           // Rich text content
  contentType   LessonContentType @default(TEXT)
  contentUrl    String?           // URL for uploaded PDF/DOCX/PPT, video URL
  duration      Int?              // Duration in minutes
  order         Int
  isPublished   Boolean           @default(false)
  moduleId      String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  module           Module            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  youtubeTutorial  YoutubeTutorial?
  progress         LessonProgress[]
  notes            Note[]

  @@map("lessons")
}

model YoutubeTutorial {
  id           String   @id @default(cuid())
  lessonId     String   @unique
  ytVideoId    String   // YouTube video ID (e.g., "dQw4w9WgXcQ")
  ytTitle      String?
  ytThumbnail  String?
  ytChannel    String?
  ytDuration   String?  // ISO 8601 duration (e.g., "PT10M30S")
  embedUrl     String?  // "https://www.youtube.com/embed/{ytVideoId}"
  teacherNotes String?  // Optional teacher notes alongside video
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("youtube_tutorials")
}

// ── Quiz System ──────────────────────────────────────────────────

model Quiz {
  id           String       @id @default(cuid())
  title        String
  moduleId     String
  timeLimit    Int?         // Time limit in minutes (null = no limit)
  passingScore Float        @default(50) // Percentage to pass
  order        Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  module    Module          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@map("quizzes")
}

model QuizQuestion {
  id           String       @id @default(cuid())
  quizId       String
  questionText String
  questionType QuestionType
  options      Json?        // Array of options for MC/TF: ["Option A", "Option B", ...]
  correctAnswer String      // Index for MC/TF, text for short answer
  points       Float        @default(1)
  order        Int          @default(0)
  createdAt    DateTime     @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@map("quiz_questions")
}

model QuizAttempt {
  id          String   @id @default(cuid())
  studentId   String
  quizId      String
  score       Float    // Percentage score
  totalPoints Float
  earnedPoints Float
  passed      Boolean
  answers     Json     // Student's answers: [{ questionId, answer, isCorrect }]
  submittedAt DateTime @default(now())

  student User @relation(fields: [studentId], references: [id])
  quiz    Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([studentId, quizId]) // One attempt per quiz (or remove for multiple attempts)
  @@map("quiz_attempts")
}

// ── Enrollments & Progress ───────────────────────────────────────

model Enrollment {
  id          String           @id @default(cuid())
  userId      String
  courseId    String
  sectionId   String?
  status      EnrollmentStatus @default(ACTIVE)
  progress    Float            @default(0)
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  course  Course   @relation(fields: [courseId], references: [id])
  section Section? @relation(fields: [sectionId], references: [id])

  @@unique([userId, courseId])
  @@map("enrollments")
}

model LessonProgress {
  id           String    @id @default(cuid())
  userId       String
  lessonId     String
  completed    Boolean   @default(false)
  completedAt  DateTime?
  lastAccessed DateTime  @default(now())
  createdAt    DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id])
  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

// ── Announcements ────────────────────────────────────────────────

model Announcement {
  id               String    @id @default(cuid())
  title            String
  body             String
  authorId         String
  courseId         String?   // null = institution-wide
  isInstitutionWide Boolean  @default(false)
  scheduledFor     DateTime? // Scheduled publish date/time
  isPublished      Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  author User   @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  course Course? @relation("CourseAnnouncements", fields: [courseId], references: [id])

  @@map("announcements")
}

// ── Reviews ──────────────────────────────────────────────────────

model Review {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
  @@map("reviews")
}

// ── Certificates ─────────────────────────────────────────────────

model Certificate {
  id             String   @id @default(cuid())
  userId         String
  courseId       String
  verificationId String   @unique @default(cuid())
  pdfUrl         String?
  issuedAt       DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
  @@map("certificates")
}

// ── Notes ────────────────────────────────────────────────────────

model Note {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  content   String
  timestamp Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@map("notes")
}

// ── Notifications ────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  data      Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

// ── AI Embeddings (for RAG) ──────────────────────────────────────

model CourseEmbedding {
  id        String                      @id @default(cuid())
  courseId  String
  content   String
  embedding Unsupported("vector(1536)")?
  createdAt DateTime                    @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("course_embeddings")
}