# ── Environment Variables ────────────────────────────────────────
# Copy this file to .env and fill in the values

# ── Application ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lms?schema=public

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Authentication ──────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=lms_token

# ── AWS S3 (File Uploads) ───────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=lms-uploads

# ── YouTube API (Optional) ──────────────────────────────────────
YOUTUBE_API_KEY=your-youtube-api-key

# ── Email (Nodemailer) ──────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@school.edu

# ── AI Features (Optional) ──────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key

# ── Institution Settings ────────────────────────────────────────
INSTITUTION_NAME=My School
INSTITUTION_LOGO_URL=
INSTITUTION_DEFAULT_LANGUAGE=en
